 "format_revision_reference": {
  "note": "格式改版参考信息；不支持按 pre/post-2023-07 筛选或映射套次（无逐套改版身份数据）。",
  "revisions": [
   {
    "id": "pre-2023-07",
    "label": "旧版 TOEFL iBT（阅读/听力/口语/写作 4 科）"
