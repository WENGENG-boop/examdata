# Phase A staging environment template (integration-staging/config/).
# Private roots only; nothing here points at the original tree, the live
# database, or an upstream host. Copy to your own file and source it in a
# private child process - never mutate the user environment.

# EXAMDATA_DATA_DIR=.data
# EXAMDATA_DATABASE_URL=sqlite:///.data/examdata.db
# EXAMDATA_NODE=
# EXAMDATA_IELTS_DIR=
# EXAMDATA_IELTS_MAX_CONCURRENT=4
# EXAMDATA_IELTS_QUEUE_TIMEOUT=5.0
# EXAMDATA_IELTS_TIMEOUT=120.0
# EXAMDATA_TOEFL_DIR=
# EXAMDATA_TOEFL_MAX_CONCURRENT=4
# EXAMDATA_TOEFL_QUEUE_TIMEOUT=5.0
# EXAMDATA_TOEFL_TIMEOUT=120.0
# EXAMDATA_API_KEY=            # secret; report only set/unset
# EXAMDATA_CORS_ORIGINS=
# EXAMDATA_URL=http://127.0.0.1:8000
# FRONTEND_PORT=5188
# EXAMDATA_COMPONENT_MANIFEST=  # new in Phase A
# EXAMDATA_CIE_INDEX_ROOT=  # new in Phase A
# EXAMDATA_TOEFL_DATA_ROOT=  # new in Phase A
# EXAMDATA_CATALOG_ROOT=  # new in Phase A
# EXAMDATA_OPERATIONS_ROOT=  # new in Phase A
# EXAMDATA_NETWORK_MODE=offline  # new in Phase A
# EXAMDATA_RUNNER_OUTPUT_BUDGET=4194304  # new in Phase A
# EXAMDATA_CROP_BUDGET=  # new in Phase A
# EXAMDATA_TOTAL_RESPONSE_BUDGET=33554432  # new in Phase A

# Aliases still honoured, with a deprecation warning:
#   IELTS_API_DIR -> EXAMDATA_IELTS_DIR
#   TOEFL_API_DIR -> EXAMDATA_TOEFL_DIR
